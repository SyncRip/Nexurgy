# Fictional local configuration only. This file contains no real credentials.
# Run the default demo with: docker compose --env-file .env.example up --build -d
# To customize it, copy this file to .env and use --env-file .env instead.

NEXURGY_WEB_PORT=8080

# Use URL-safe characters (letters, digits, hyphens, underscores) for this value.
# Compose uses it in PostgreSQL settings and the application's database URL.
NEXURGY_DB_PASSWORD=nexurgy-local-db-only

# Applied only when demo accounts are first created. Existing passwords remain.
NEXURGY_DEMO_PASSWORD=nexurgy-local-demo-only

# The local demo uses explicitly labelled simulated AI, without a provider key.
# Set false only when configuring an actual model provider yourself.
NEXURGY_AI_SIMULATION=true

# Optional runtime-only values. Keep blank for the default local demo.
# Never add real values to this example file or to Docker build arguments.
NEXURGY_GEMINI_API_KEY=
NEXURGY_OPENAI_API_KEY=

# Optional: needed only for saving direct provider keys in the application's UI.
# Format: v1:<base64-encoded 32-byte key>. Keep the same value across restarts.
# Environment-referenced provider keys do not require this setting.
NEXURGY_CREDENTIAL_KEYS=
