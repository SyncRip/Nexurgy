# Copy to server/.env and adjust. Every variable is optional in local dev.
PARTROUTE_ENV=dev
PARTROUTE_DATABASE_URL=postgresql+psycopg://partroute:partroute@localhost:5544/partroute
PARTROUTE_CORS_ORIGINS=http://localhost:5188,http://127.0.0.1:5188

# Files: local directory (default server/var/blobs) or Google Cloud Storage.
PARTROUTE_STORAGE_BACKEND=local
# PARTROUTE_STORAGE_DIR=/absolute/path/for/blobs
# PARTROUTE_STORAGE_BACKEND=gcs
# PARTROUTE_GCS_BUCKET=your-bucket

# Run workflow workers inside the API process (set false when a separate
# `python -m app.worker` service runs them).
PARTROUTE_INLINE_WORKER=true
PARTROUTE_WORKER_THREADS=2

# Deployment feature switches. Restart API and workers together; startup records
# the effective configuration and eligible existing runs. Disabling tasks also
# disables new collaboration. Existing records remain readable.
PARTROUTE_FEATURE_COLLABORATION=false
PARTROUTE_FEATURE_TASKS=false
PARTROUTE_FEATURE_STAGES=false
PARTROUTE_FEATURE_PROCESS_MODULES=false
PARTROUTE_FEATURE_TEMPLATE_LIBRARY=false
# These control ordinary request overrides, not model administration or CAD work.
PARTROUTE_FEATURE_TURBO_CHOICE=false
PARTROUTE_FEATURE_MODEL_CHOICE=false

# Model provider keys. Model configs in the database reference these by name
# (secret_ref "env:GEMINI_API_KEY"); the keys never enter the database.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Default model ids used when seeding model configs (change any time in Settings).
PARTROUTE_DEFAULT_GEMINI_MODEL=gemini-2.5-flash
PARTROUTE_DEFAULT_OPENAI_MODEL=gpt-5-mini

# Use a deterministic fake model when no key is configured (dev/test only; rejected in production; results are
# labelled "simulated" and do not count as real AI runs).
PARTROUTE_AI_SIMULATION=false
