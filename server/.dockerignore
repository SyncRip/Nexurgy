# Only application source, migrations, and dependency metadata enter this build.
**
!Dockerfile
!pyproject.toml
!uv.lock
!alembic.ini
!app/
!app/**
!alembic/
!alembic/**

# Defense in depth for sensitive or generated files inside allowed directories.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/credentials.json
**/credentials.*.json
**/credentials.yaml
**/credentials.yml
**/.credentials
**/*credentials*.json
**/service-account*.json
**/service_account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.git
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
**/tests
**/var
**/deploy
**/.gcloudignore
